rules_version = '2';
// Logos : lisibles par tous, remplacés par le partenaire concerné ou le bureau, image < 1 Mo.
service firebase.storage {
  match /b/{bucket}/o {
    match /logos/{uid}.jpg {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.uid == uid || request.auth.token.role == 'admin')
        && request.resource.size < 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
